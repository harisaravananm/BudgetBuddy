VITE_API_URL=http://127.0.0.1:8000
VITE_DEMO_MODE=true
VITE_GOOGLE_CLIENT_ID=
VITE_GITHUB_CLIENT_ID=

# --- Client-Side Email Notifications via EmailJS (Optional) ---
# Create a free account at https://www.emailjs.com/ (200 free emails/month)
# 1. Create an Email Service (e.g. Gmail or Outlook) -> copy Service ID
# 2. Create an Email Template with variables: {{to_name}}, {{to_email}}, {{subject}}, {{message}}, {{alert_type}}, {{amount}} -> copy Template ID
# 3. Account > API Keys -> copy Public Key
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
