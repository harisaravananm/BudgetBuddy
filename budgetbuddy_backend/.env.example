# ==============================================================================
# BudgetBuddy Environment Configuration (.env)
# ==============================================================================

# --- Django Security ---
DJANGO_SECRET_KEY=dev-secret-key-replace-in-production-random-64-chars
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database Setup (SQLite by default, or PostgreSQL) ---
# Leave empty for local SQLite (db.sqlite3):
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Or provide a full PostgreSQL connection URL (e.g. for Render / Supabase / Neon / AWS RDS):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Real-Time Email Notifications (SMTP via Gmail or SendGrid) ---
# For Development Console Testing (prints emails to console):
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# For Real-Time SMTP Delivery via Gmail (App Password):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_HOST_USER=your_gmail_address@gmail.com
# EMAIL_HOST_PASSWORD=your_16_digit_google_app_password
# DEFAULT_FROM_EMAIL=BudgetBuddy Alert <your_gmail_address@gmail.com>

# For Real-Time SMTP Delivery via SendGrid:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=your_sendgrid_api_key
# DEFAULT_FROM_EMAIL=BudgetBuddy Alert <verified_sender@yourdomain.com>

# --- Optional OAuth2 Providers ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
