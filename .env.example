# ==============================================================================
# BudgetBuddy Environment Configuration (.env)
# ==============================================================================

# --- Django Security ---
DJANGO_SECRET_KEY=dev-secret-key-replace-in-production-random-64-chars
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database Setup (SQLite by default, or Supabase / PostgreSQL) ---
# OPTION A (Default): Leave DATABASE_URL empty to use local SQLite (db.sqlite3).
DATABASE_URL=

# OPTION B: Supabase Managed PostgreSQL
# Get your connection string from: Supabase Dashboard > Project Settings > Database
# 1. Transaction Pooler (Recommended - Port 6543):
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# 2. Direct Connection (Port 5432):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
# Or alias:
# SUPABASE_DB_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# --- Real-Time Email Notifications & Authentication ---
# For Development & Local Testing (Prints emails & 6-digit OTP codes cleanly to console):
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# For Real-Time SMTP Delivery via Gmail (App Password):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_HOST_USER=your_gmail_address@gmail.com
# EMAIL_HOST_PASSWORD=your_16_digit_google_app_password
# DEFAULT_FROM_EMAIL=BudgetBuddy Alert <your_gmail_address@gmail.com>

# For Real-Time SMTP Delivery via SendGrid:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=your_sendgrid_api_key
# DEFAULT_FROM_EMAIL=BudgetBuddy Alert <verified_sender@yourdomain.com>

# --- Optional OAuth2 Providers ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
